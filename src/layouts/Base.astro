---
import '../styles/global.css';
import { site, u } from '../lib/site.js';

const { baslik, aciklama = site.aciklama } = Astro.props;
const tamBaslik = baslik ? `${baslik} | ${site.ad}` : `${site.ad} | Kulak çınlaması, hiperakuzi ve mizofoni`;
const yol = Astro.url.pathname;
const canonical = new URL(yol, Astro.site);
const menu = [
  { ad: 'Hakkımızda', yol: '/hakkimizda/' },
  { ad: 'Hizmetler', yol: '/hizmetler/' },
  { ad: 'Bilgi Merkezi', yol: '/bilgi-merkezi/' },
  { ad: 'Blog', yol: '/blog/' },
];
const aktif = (p) => (yol.startsWith(u(p)) ? 'page' : undefined);
const { telefon, eposta } = site.iletisim;
const sosyal = Object.entries(site.sosyal).filter(([, v]) => v);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tamBaslik}</title>
    <meta name="description" content={aciklama} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <meta property="og:title" content={tamBaslik} />
    <meta property="og:description" content={aciklama} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0a1b2e" />
  </head>
  <body>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={u('/')} aria-label={`${site.ad} ana sayfa`}>
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="9" fill="#0f2740"></rect>
            <g fill="#3cc9c2">
              <rect x="6" y="9" width="2.6" height="14" rx="1.3"></rect>
              <rect x="11" y="12" width="2.6" height="8" rx="1.3"></rect>
              <rect x="16" y="13.5" width="2.6" height="5" rx="1.3"></rect>
            </g>
            <rect x="21" y="14.7" width="5.5" height="2.6" rx="1.3" fill="#f2b544"></rect>
          </svg>
          {site.ad}
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu">Menü</button>
        <nav class="nav" id="menu" aria-label="Ana menü">
          {menu.map((m) => <a href={u(m.yol)} aria-current={aktif(m.yol)}>{m.ad}</a>)}
          <a class="nav-cta" href={u('/iletisim/')}>İletişim</a>
        </nav>
      </div>
    </header>

    <main id="icerik">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="logo" href={u('/')}>{site.ad}</a>
            <p>{site.aciklama}</p>
            {telefon && <p><a href={`tel:${telefon.replace(/\s/g, '')}`}>{telefon}</a></p>}
            {eposta && <p><a href={`mailto:${eposta}`}>{eposta}</a></p>}
          </div>
          <div>
            <h2>Site</h2>
            <ul>
              {menu.map((m) => <li><a href={u(m.yol)}>{m.ad}</a></li>)}
              <li><a href={u('/iletisim/')}>İletişim</a></li>
            </ul>
          </div>
          <div>
            <h2>Yasal</h2>
            <ul>
              <li><a href={u('/kvkk/')}>KVKK aydınlatma metni</a></li>
              <li><a href={u('/tibbi-uyari/')}>Tıbbi bilgi uyarısı</a></li>
              <li><a href={u('/cerez-politikasi/')}>Çerez politikası</a></li>
              {sosyal.map(([ad, adres]) => (
                <li><a href={adres} rel="noopener" style="text-transform:capitalize">{ad}</a></li>
              ))}
            </ul>
          </div>
        </div>
        <div class="footer-note">
          <p>
            Bu sitedeki içerikler yalnızca bilgilendirme amacı taşır; tanı ve tedavi için hekime veya ilgili sağlık
            meslek mensubuna başvurulmalıdır.
          </p>
          <p>© {new Date().getFullYear()} {site.ad}. Tüm hakları saklıdır.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.querySelector('.menu-btn');
        const nav = document.getElementById('menu');
        btn?.addEventListener('click', () => {
          const acik = nav.classList.toggle('open');
          btn.setAttribute('aria-expanded', String(acik));
          btn.textContent = acik ? 'Kapat' : 'Menü';
        });
      })();
    </script>
  </body>
</html>
