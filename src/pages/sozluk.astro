---
import Base from '../layouts/Base.astro';
import sozluk from '../data/sozluk.json';
const liste = (Array.isArray(sozluk) ? sozluk : []).filter((t) => t?.terim).sort((a, b) => a.terim.localeCompare(b.terim, 'tr'));
---

<Base baslik="Terimler sözlüğü" aciklama="Odyoloji ve kulak burun boğaz alanında sık kullanılan terimlerin açıklamaları.">
  <div class="page-head">
    <div class="wrap">
      <h1>Terimler sözlüğü</h1>
      <p>Odyoloji ve kulak burun boğaz alanında sık kullanılan terimlerin açıklamaları.</p>
    </div>
  </div>
  <section class="section">
    <div class="wrap">
      <dl class="glossary">
        {
          liste.map((t) => (
            <div>
              <dt>{t.terim}</dt>
              <dd>{t.tanim}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>
