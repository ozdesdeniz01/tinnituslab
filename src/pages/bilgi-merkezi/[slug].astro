---
import Base from '../../layouts/Base.astro';
import { u, bilgiYazilari } from '../../lib/site.js';

export function getStaticPaths() {
  return bilgiYazilari().map((y) => ({ params: { slug: y.slug } }));
}
const tumu = bilgiYazilari();
const yazi = tumu.find((y) => y.slug === Astro.params.slug);
const { Content } = yazi;
---

<Base baslik={yazi.baslik} aciklama={yazi.ozet}>
  <div class="page-head">
    <div class="wrap">
      <p class="meta" style="font-size:1rem;margin-bottom:.6rem"><a href={u('/bilgi-merkezi/')}>Bilgi Merkezi</a></p>
      <h1>{yazi.baslik}</h1>
      <p>{yazi.ozet}</p>
    </div>
  </div>
  <section class="section">
    <div class="wrap article">
      <div>
        <div class="prose"><Content /></div>
        <div class="disclaimer">
          <p>
            Bu yazı genel bilgilendirme amacıyla hazırlanmıştır; tanı veya tedavi önerisi niteliği taşımaz. Şikâyetleriniz
            için hekime başvurunuz.
          </p>
        </div>
      </div>
      <aside class="aside">
        <h2>Diğer konular</h2>
        <ul>
          {tumu.filter((y) => y.slug !== yazi.slug).map((y) => <li><a href={u(`/bilgi-merkezi/${y.slug}/`)}>{y.baslik}</a></li>)}
        </ul>
      </aside>
    </div>
  </section>
</Base>
