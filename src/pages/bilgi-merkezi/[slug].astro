---
import Base from '../../layouts/Base.astro';
import Paylas from '../../components/Paylas.astro';
import { site, u, bilgiYazilari, tarih, isoTarih, paylasimGorseli } from '../../lib/site.js';

export function getStaticPaths() {
  return bilgiYazilari().map((y) => ({ params: { slug: y.slug } }));
}
const tumu = bilgiYazilari();
const yazi = tumu.find((y) => y.slug === Astro.params.slug);
const { Content } = yazi;
const kaynaklar = yazi.kaynaklar ?? [];
const veri = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  headline: yazi.baslik,
  description: yazi.ozet,
  inLanguage: 'tr',
  ...(isoTarih(yazi.guncelleme) ? { dateModified: isoTarih(yazi.guncelleme) } : {}),
  ...(yazi.denetlendi && site.uzman.ad ? { reviewedBy: { '@type': 'Person', name: site.uzman.ad } } : {}),
};
---

<Base baslik={yazi.baslik} aciklama={yazi.ozet} yapisalVeri={veri} gorsel={paylasimGorseli(yazi.slug)} tur="article">
  <div class="page-head">
    <div class="wrap">
      <p class="meta" style="font-size:1rem;margin-bottom:.6rem"><a href={u('/bilgi-merkezi/')}>Bilgi Merkezi</a></p>
      <h1>{yazi.baslik}</h1>
      <p>{yazi.ozet}</p>
    </div>
  </div>
  <section class="section">
    <div class="wrap article">
      <div>
        <div class="prose"><Content /></div>
        {
          kaynaklar.length > 0 && (
            <div class="refs">
              <h2>Kaynaklar</h2>
              <ol>{kaynaklar.map((k) => <li>{k}</li>)}</ol>
            </div>
          )
        }
        <Paylas baslik={yazi.baslik} />
        <div class="disclaimer">
          {tarih(yazi.guncelleme) && <p style="margin-bottom:.5rem">Son güncelleme: {tarih(yazi.guncelleme)}</p>}
          {yazi.denetlendi && site.uzman.ad && <p style="margin-bottom:.5rem">İçerik denetimi: {site.uzman.ad}</p>}
          <p>
            Bu yazı genel bilgilendirme amacıyla hazırlanmıştır; tanı veya tedavi önerisi niteliği taşımaz. Şikâyetleriniz
            için hekime başvurunuz.
          </p>
        </div>
      </div>
      <aside class="aside">
        <h2>Diğer konular</h2>
        <ul>
          {tumu.filter((y) => y.slug !== yazi.slug).map((y) => <li><a href={u(`/bilgi-merkezi/${y.slug}/`)}>{y.baslik}</a></li>)}
        </ul>
      </aside>
    </div>
  </section>
</Base>
