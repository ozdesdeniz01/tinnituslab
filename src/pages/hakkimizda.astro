---
import Base from '../layouts/Base.astro';
import yayinlar from '../data/yayinlar.json';
import { site, u } from '../lib/site.js';
const liste = [...yayinlar].sort((a, b) => b.yil - a.yil);
const { ad, unvan, ozgecmis, foto, fotoAciklama, scholar } = site.uzman;
const veri = ad && {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: ad.replace(/^Dr\.\s*/, ''),
  honorificPrefix: 'Dr.',
  jobTitle: unvan,
  knowsAbout: ['Tinnitus', 'Hiperakuzi', 'Mizofoni', 'Odyoloji'],
  ...(scholar ? { sameAs: [scholar] } : {}),
};
---

<Base baslik="Hakkımızda" aciklama="TinnitusLab bilgilendirme platformunun kapsamı, yaklaşımı ve ilkeleri." yapisalVeri={veri || undefined}>
  <div class="page-head">
    <div class="wrap">
      <h1>Hakkımızda</h1>
      <p>Kulak çınlaması ve ses toleransı alanında bilimsel kanıta dayalı bilgilendirme.</p>
    </div>
  </div>

  {
    ad && (
      <section class="section" style="padding-bottom:0">
        <div class="wrap bio">
          {foto && (
            <figure>
              <img src={u(foto)} alt={ad} width="300" height="362" />
              {fotoAciklama && <figcaption>{fotoAciklama}</figcaption>}
            </figure>
          )}
          <div class="prose">
            <h2>{ad}</h2>
            {unvan && <p class="meta">{unvan}</p>}
            {ozgecmis && ozgecmis.split('\n\n').map((p) => <p>{p}</p>)}
            <p style="margin-top:1.5rem;display:flex;flex-wrap:wrap;gap:.75rem">
              <a class="btn btn-primary" href="#akademik-calismalar">Akademik çalışmalar</a>
              {scholar && <a class="btn btn-ghost" href={scholar} rel="noopener">Google Akademik profili</a>}
            </p>
          </div>
        </div>
      </section>
    )
  }

  {
    ad && liste.length > 0 && (
      <section class="section" id="akademik-calismalar" style="padding-bottom:0;scroll-margin-top:5rem">
        <div class="wrap">
          <div class="section-head" style="margin-bottom:1.75rem">
            <h2>Akademik çalışmalar</h2>
            <p>Uluslararası hakemli dergilerde yayımlanmış seçilmiş çalışmalar.</p>
          </div>
          <ol class="pubs">
            {liste.map((y) => (
              <li>
                <span class="yil">{y.yil}</span>
                <div>
                  <h3>{y.baglanti ? <a href={y.baglanti} rel="noopener">{y.baslik}</a> : y.baslik}</h3>
                  <p>
                    {y.yazarlar} <em>{y.dergi}</em>
                    {y.ayrinti && `, ${y.ayrinti}`}.
                  </p>
                </div>
              </li>
            ))}
          </ol>
          {scholar && (
            <p class="meta" style="margin-top:1.25rem">
              Yayınların güncel ve eksiksiz listesi için <a href={scholar} rel="noopener">Google Akademik profiline</a> bakınız.
            </p>
          )}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap prose">
      <h2>Platformun kapsamı</h2>
      <p>
        TinnitusLab; kulak çınlaması (tinnitus), ses hassasiyeti (hiperakuzi) ve mizofoni hakkında bilgi sunan bir
        bilgilendirme platformudur. Bu üç durum sıklıkla birlikte görülür, günlük yaşamı farklı ölçülerde etkiler ve her
        biri kendine özgü bir değerlendirme gerektirir.
      </p>
      <p>
        Platform bir sağlık kuruluşu değildir; muayene, tanı veya tedavi hizmeti vermez. İçerikler, okurun durumunu daha
        iyi anlamasına ve başvuracağı sağlık meslek mensubuyla daha verimli bir görüşme yapmasına yardımcı olmayı amaçlar.
      </p>

      <h2>Yaklaşımımız</h2>
      <p>
        Çınlamanın yarattığı sıkıntının önemli bir bölümü belirsizlikten kaynaklanır: sesin neden ortaya çıktığı, kalıcı
        olup olmadığı ve neye işaret ettiği bilinmediğinde kaygı artar. Bu nedenle platformun temelini doğru ve anlaşılır
        bilgi oluşturur.
      </p>
      <p>
        İçerikleri hazırlarken güncel bilimsel kanıtları ve uluslararası kılavuzları esas alırız. Etkisi gösterilmemiş
        yöntemleri önermez, sonuç güvencesi vermeyiz. Her kişinin şikâyeti, işitme durumu ve yaşam koşulları farklıdır;
        bu nedenle buradaki bilgiler kişiye özgü değerlendirmenin yerini tutmaz.
      </p>

      <h2>İlkelerimiz</h2>
      <ul>
        <li><strong>Kanıta dayalılık:</strong> Paylaştığımız bilgiler bilimsel yayınlara dayanır ve kaynakları yazıların sonunda belirtilir.</li>
        <li><strong>Açıklık:</strong> Neyin bilindiğini ve neyin henüz bilinmediğini olduğu gibi aktarırız.</li>
        <li><strong>Doğru yönlendirme:</strong> Hangi durumda hangi sağlık meslek mensubuna başvurulması gerektiğini açıkça belirtiriz.</li>
        <li><strong>Gizlilik:</strong> Kişisel veriler ilgili mevzuata uygun biçimde korunur; site ziyaretçileri izlenmez.</li>
      </ul>
    </div>
  </section>
</Base>
