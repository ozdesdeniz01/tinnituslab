---
import Base from '../../layouts/Base.astro';
import Paylas from '../../components/Paylas.astro';
import { u, notlar, tarih, paylasimGorseli } from '../../lib/site.js';

export function getStaticPaths() {
  return notlar().map((y) => ({ params: { slug: y.slug } }));
}
const yazi = notlar().find((y) => y.slug === Astro.params.slug);
const { Content } = yazi;
---

<Base baslik={yazi.baslik} aciklama={yazi.ozet} gorsel={paylasimGorseli(yazi.slug)} tur="article">
  <div class="page-head">
    <div class="wrap">
      <p class="meta" style="font-size:1rem;margin-bottom:.6rem">
        <a href={u('/notlar/')}>Araştırma Notları</a>, <time datetime={new Date(yazi.tarih).toISOString().slice(0, 10)}>{tarih(yazi.tarih)}</time>
      </p>
      <h1>{yazi.baslik}</h1>
      <p>{yazi.ozet}</p>
    </div>
  </div>
  <section class="section">
    <div class="wrap">
      <div class="prose"><Content /></div>
      <Paylas baslik={yazi.baslik} />
      <div class="disclaimer">
        <p>
          Bu yazı genel bilgilendirme amacıyla hazırlanmıştır; tanı veya tedavi önerisi niteliği taşımaz. Şikâyetleriniz
          için hekime başvurunuz.
        </p>
      </div>
    </div>
  </section>
</Base>
