---
import Base from '../layouts/Base.astro';
import hizmetler from '../data/hizmetler.json';
import { u } from '../lib/site.js';
---

<Base baslik="Hizmetler" aciklama="Tinnitus, hiperakuzi ve mizofoniye yönelik değerlendirme, danışmanlık ve ses terapisi hizmetleri.">
  <div class="page-head">
    <div class="wrap">
      <h1>Hizmetler</h1>
      <p>Her başvuru değerlendirmeyle başlar. İzlem planı, değerlendirmenin sonuçlarına ve kişinin önceliklerine göre oluşturulur.</p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="rows">
        {
          hizmetler.map((h) => (
            <div class="row">
              <h2 style="font-size:1.6rem;margin:0">{h.baslik}</h2>
              <div>
                <p><strong>{h.ozet}</strong></p>
                <p>{h.detay}</p>
              </div>
            </div>
          ))
        }
      </div>
      <div class="disclaimer">
        <p>
          Bu sayfadaki bilgiler genel bilgilendirme amacı taşır. Uygulanacak yaklaşım, kişiye özgü değerlendirme sonrasında
          belirlenir; sonuçlar kişiden kişiye değişir.
        </p>
      </div>
    </div>
  </section>

  <section class="section closing">
    <div class="wrap">
      <div>
        <h2>Değerlendirme için başvurun</h2>
        <p>Randevu talebinizi veya sorunuzu iletişim sayfasından iletebilirsiniz.</p>
      </div>
      <a class="btn btn-primary" href={u('/iletisim/')}>İletişim sayfasına gidin</a>
    </div>
  </section>
</Base>
