---
import Base from '../layouts/Base.astro';
import { u } from '../lib/site.js';
---

<Base baslik="Ortam sesi aracı" aciklama="Tarayıcıda çalışan ücretsiz ortam sesi aracı: beyaz, pembe ve kahverengi gürültü ile dalga sesi.">
  <div class="page-head">
    <div class="wrap">
      <h1>Ortam sesi aracı</h1>
      <p>
        Sessiz ortamlarda hafif bir arka plan sesi, çınlama ile ortam arasındaki karşıtlığı azaltarak çınlamanın daha az
        fark edilmesine yardımcı olabilir.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="player">
        <div class="sounds" role="group" aria-label="Ses türü">
          <button type="button" data-ses="beyaz" aria-pressed="false">Beyaz gürültü<span>Hışırtıya benzer, parlak</span></button>
          <button type="button" data-ses="pembe" aria-pressed="false">Pembe gürültü<span>Yağmura benzer, dengeli</span></button>
          <button type="button" data-ses="kahverengi" aria-pressed="false">Kahverengi gürültü<span>Şelaleye benzer, derin</span></button>
          <button type="button" data-ses="dalga" aria-pressed="false">Dalga<span>Kıyıya vuran dalgalar</span></button>
        </div>
        <div class="player-row">
          <label>
            Ses düzeyi
            <input type="range" id="duzey" min="0" max="100" value="25" />
          </label>
          <label>
            Zamanlayıcı
            <select id="sure">
              <option value="0">Sürekli</option>
              <option value="15">15 dakika</option>
              <option value="30">30 dakika</option>
              <option value="60">60 dakika</option>
            </select>
          </label>
        </div>
        <p class="player-status" id="durum" role="status" aria-live="polite">Dinlemek için bir ses türü seçin.</p>
      </div>

      <div class="prose" style="margin-top:3rem">
        <h2>Nasıl kullanılır?</h2>
        <ul>
          <li>
            Ses düzeyini çınlamanızı bütünüyle bastıracak kadar değil, çınlamanın biraz altında kalacak kadar ayarlayın.
            Amaç çınlamayı örtmek değil, sessizlikle arasındaki karşıtlığı azaltmaktır.
          </li>
          <li>Size en rahat gelen ses türünü seçin; herkes için en iyi tek bir ses yoktur.</li>
          <li>Uykuya geçerken zamanlayıcıyı kullanabilirsiniz; süre dolduğunda ses yavaşça kısılarak kapanır.</li>
          <li>Kulaklık yerine hoparlör kullanmanız ve ses düzeyini düşük tutmanız önerilir.</li>
        </ul>
        <h2>Bilinmesi gerekenler</h2>
        <p>
          Bu araç bir tedavi yöntemi veya tıbbi cihaz değildir; gündelik yaşamda rahatlamaya yardımcı olması amacıyla
          sunulmuştur. Sesler tarayıcınızda üretilir; herhangi bir veri kaydedilmez veya gönderilmez. Ses hassasiyetiniz
          varsa çok düşük bir düzeyle başlayın ve rahatsızlık duyarsanız kullanmayı bırakın.
        </p>
        <p>
          Sessizliğin çınlamayı neden belirginleştirdiği hakkında
          <a href={u('/yazilar/cinlama-geceleri-neden-artar/')}>bu yazıyı</a> okuyabilirsiniz.
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const dugmeler = document.querySelectorAll('.sounds button');
      const duzey = document.getElementById('duzey');
      const sure = document.getElementById('sure');
      const durum = document.getElementById('durum');
      const adlar = { beyaz: 'Beyaz gürültü', pembe: 'Pembe gürültü', kahverengi: 'Kahverengi gürültü', dalga: 'Dalga' };
      let ctx, kaynak, kazanc, lfo, zamanlayici, etkin = null;

      const tampon = (tur) => {
        const n = ctx.sampleRate * 8;
        const buf = ctx.createBuffer(1, n, ctx.sampleRate);
        const d = buf.getChannelData(0);
        if (tur === 'beyaz') {
          for (let i = 0; i < n; i++) d[i] = (Math.random() * 2 - 1) * 0.35;
        } else if (tur === 'pembe') {
          let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
          for (let i = 0; i < n; i++) {
            const w = Math.random() * 2 - 1;
            b0 = 0.99886 * b0 + w * 0.0555179;
            b1 = 0.99332 * b1 + w * 0.0750759;
            b2 = 0.969 * b2 + w * 0.153852;
            b3 = 0.8665 * b3 + w * 0.3104856;
            b4 = 0.55 * b4 + w * 0.5329522;
            b5 = -0.7616 * b5 - w * 0.016898;
            d[i] = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + w * 0.5362) * 0.09;
            b6 = w * 0.115926;
          }
        } else {
          let son = 0;
          for (let i = 0; i < n; i++) {
            const w = Math.random() * 2 - 1;
            son = (son + 0.02 * w) / 1.02;
            d[i] = son * 3;
          }
        }
        return buf;
      };

      const durdur = (yavas) => {
        clearTimeout(zamanlayici);
        if (!kaynak) return;
        const k = kaynak, g = kazanc, l = lfo;
        const t = ctx.currentTime, s = yavas ? 6 : 0.3;
        g.gain.cancelScheduledValues(t);
        g.gain.setValueAtTime(g.gain.value, t);
        g.gain.linearRampToValueAtTime(0, t + s);
        setTimeout(() => { try { k.stop(); l && l.stop(); } catch {} }, s * 1000 + 100);
        kaynak = null; lfo = null; etkin = null;
        dugmeler.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      };

      const hedef = () => Math.pow(duzey.value / 100, 2);

      const baslat = (tur) => {
        ctx = ctx || new (window.AudioContext || window.webkitAudioContext)();
        ctx.resume();
        durdur(false);
        kaynak = ctx.createBufferSource();
        kaynak.buffer = tampon(tur === 'dalga' ? 'kahverengi' : tur);
        kaynak.loop = true;
        kazanc = ctx.createGain();
        kazanc.gain.value = 0;
        let dugum = kaynak;
        if (tur === 'dalga') {
          const dalga = ctx.createGain();
          dalga.gain.value = 0.55;
          lfo = ctx.createOscillator();
          lfo.frequency.value = 0.11;
          const derinlik = ctx.createGain();
          derinlik.gain.value = 0.45;
          lfo.connect(derinlik).connect(dalga.gain);
          lfo.start();
          kaynak.connect(dalga);
          dugum = dalga;
        }
        dugum.connect(kazanc).connect(ctx.destination);
        kaynak.start();
        kazanc.gain.linearRampToValueAtTime(hedef(), ctx.currentTime + 1.5);
        etkin = tur;
        dugmeler.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ses === tur)));
        kur();
      };

      const kur = () => {
        clearTimeout(zamanlayici);
        if (!etkin) return;
        const dk = Number(sure.value);
        durum.textContent = dk ? `${adlar[etkin]} çalıyor. ${dk} dakika sonra kapanacak.` : `${adlar[etkin]} çalıyor.`;
        if (dk) zamanlayici = setTimeout(() => { durdur(true); durum.textContent = 'Zamanlayıcı doldu, ses kapatıldı.'; }, dk * 60000);
      };

      dugmeler.forEach((b) =>
        b.addEventListener('click', () => {
          if (etkin === b.dataset.ses) { durdur(false); durum.textContent = 'Ses durduruldu.'; }
          else baslat(b.dataset.ses);
        })
      );
      duzey.addEventListener('input', () => {
        if (kazanc && etkin) kazanc.gain.setTargetAtTime(hedef(), ctx.currentTime, 0.05);
      });
      sure.addEventListener('change', kur);
    })();
  </script>
</Base>
